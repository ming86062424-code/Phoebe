# Phoebe 設定範例（本機快速測試用）：複製為 .env 後修改。環境變數優先於此檔。
# Docker 部署請改用 docker/.env.example。
# 值皆為預設值。

# ===== Ollama 與模型 =====
# Ollama 服務位址
OLLAMA_BASE_URL=http://localhost:11434
# 對話模型
CHAT_MODEL=gemma4:e4b
# 評測用的評審模型
EVAL_JUDGE_MODEL=qwen3.5:4b
# 是否啟用思考模式（true/false）
CHAT_THINK=true

# ===== Gemini 與管理員 =====
# Gemini API key（到 https://aistudio.google.com/apikey 取得）。只放在這裡，不會存進資料庫，也不會出現在介面。
GEMINI_API_KEY=
# Gemini 預設模型（可在系統設定頁改）
GEMINI_MODEL=gemini-2.5-flash
# 管理員帳號（逗號分隔，大小寫須完全一致）；可進入系統設定頁。留空表示沒有管理員
ADMIN_USERNAMES=

# ===== 應用程式 =====
# SQLite 資料庫路徑（留空使用專案內 data/app.db）
# DB_PATH=
# 登入有效天數
SESSION_DAYS=7
# 前端建置輸出目錄（留空使用專案內 frontend/dist）
# FRONTEND_DIST=
# 對話回覆鎖逾時秒數（串流中每 30 秒更新一次，應大於 30）
REPLY_LOCK_TTL_SECONDS=90

# ===== 知識庫 =====
# Embedding 服務位址（docker compose up -d embedder 後為 http://localhost:8002）
EMBEDDER_URL=http://localhost:8002
# 上傳檔案目錄（留空使用專案內 data/kb）
# KB_DIR=
# 檢索回傳的片段數
KB_TOP_K=5
# 回答時附給模型的參考圖片上限（依參考資料順序，頁面圖優先）；0 表示不附圖
KB_MAX_IMAGES=4
# 單檔上傳上限（MB）
MAX_UPLOAD_MB=50
# 文件解析 worker 模式：embedded（內嵌於 web）或 external（獨立 worker）
KB_WORKER_MODE=embedded
# worker 輪詢間隔（秒）
KB_WORKER_POLL_SECONDS=2
# 解析中逾時多久視為卡住並重新排入（秒）
KB_STALE_SECONDS=120
# 處理中的文件每隔幾秒刷新 updated_at（須小於 KB_STALE_SECONDS）
KB_HEARTBEAT_SECONDS=30

# ===== OCR =====
# OCR 後端：transformers（本機載入模型，需 uv sync --group ocr）或 vllm
# 本機快速測試也可呼叫 Docker 的 vLLM：cd docker && docker compose up -d vllm，
# 然後設 OCR_BACKEND=vllm 與 VLLM_BASE_URL=http://localhost:8001/v1
OCR_BACKEND=transformers
# OCR 模型
OCR_MODEL=lightonai/LightOnOCR-3-0.8B
# LiteParse 的 OCR 語言
LITEPARSE_OCR_LANGUAGE=chi_tra+eng
# vLLM 服務位址（OCR_BACKEND=vllm 時使用）
VLLM_BASE_URL=http://localhost:8001/v1

# ===== Milvus =====
# Milvus 位址（快速測試：cd docker && docker compose up -d milvus）
MILVUS_URI=http://localhost:19530
# Milvus token（有啟用驗證時使用，否則留空）
MILVUS_TOKEN=
# 儲存知識庫片段的 collection 名稱
MILVUS_COLLECTION=phoebe_chunks
