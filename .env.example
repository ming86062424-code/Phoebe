# Phoebe 設定範例（本機快速測試用）：複製為 .env 後修改。環境變數優先於此檔。
# Docker 部署請改用 docker/.env.example。
# 值皆為預設值。

# ===== Ollama 與模型 =====
# Ollama 服務位址
OLLAMA_BASE_URL=http://localhost:11434
# 對話模型
CHAT_MODEL=gemma4:e4b
# 評測用的評審模型
EVAL_JUDGE_MODEL=qwen3.5:4b
# 是否啟用思考模式（true/false）
CHAT_THINK=true

# ===== 應用程式 =====
# SQLite 資料庫路徑（留空使用專案內 data/app.db）
# DB_PATH=
# 登入有效天數
SESSION_DAYS=7
# 前端建置輸出目錄（留空使用專案內 frontend/dist）
# FRONTEND_DIST=
# 對話回覆鎖逾時秒數
REPLY_LOCK_TTL_SECONDS=600

# ===== 知識庫 =====
# 嵌入模型
EMBED_MODEL=embeddinggemma-2
# 上傳檔案目錄（留空使用專案內 data/kb）
# KB_DIR=
# Chroma 本機資料目錄（留空使用專案內 data/chroma）
# CHROMA_DIR=
# 檢索回傳的片段數
KB_TOP_K=5
# 單檔上傳上限（MB）
MAX_UPLOAD_MB=50
# 文件解析 worker 模式：embedded（內嵌於 web）或 external（獨立 worker）
KB_WORKER_MODE=embedded
# worker 輪詢間隔（秒）
KB_WORKER_POLL_SECONDS=2
# 解析中逾時多久視為卡住並重新排入（秒）
KB_STALE_SECONDS=120
# 處理中的文件每隔幾秒刷新 updated_at（須小於 KB_STALE_SECONDS）
KB_HEARTBEAT_SECONDS=30

# ===== OCR =====
# OCR 後端：transformers 或 vllm
OCR_BACKEND=transformers
# OCR 模型
OCR_MODEL=lightonai/LightOnOCR-3-0.8B
# LiteParse 的 OCR 語言
LITEPARSE_OCR_LANGUAGE=chi_tra+eng
# vLLM 服務位址（OCR_BACKEND=vllm 時使用）
VLLM_BASE_URL=http://localhost:8001/v1

# ===== Chroma 服務 =====
# Chroma 主機（留空則使用本機檔案模式）
CHROMA_HOST=
# Chroma 連接埠
CHROMA_PORT=8000
