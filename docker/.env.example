# Phoebe Docker 部署設定：在 docker/ 目錄執行 cp .env.example .env 後修改。
# 此檔同時供 Compose 變數插值（${...}）與容器環境變數使用。
# 專案根目錄的 .env 只給本機快速測試，與此檔無關。

# ===== Compose 與連接埠 =====
# 對外連接埠
PHOEBE_PORT=8000
# Gunicorn worker 數量
WEB_CONCURRENCY=2

# ===== Ollama 與模型 =====
# 對話模型（Ollama 在主機上，位址由 compose 固定）
CHAT_MODEL=gemma4:e4b
# 評測用的評審模型
EVAL_JUDGE_MODEL=qwen3.5:4b
# 是否啟用思考模式（true/false）
CHAT_THINK=true

# ===== Gemini 與管理員 =====
# Gemini API key（到 https://aistudio.google.com/apikey 取得）。只放在這裡，不會存進資料庫，也不會出現在介面。
GEMINI_API_KEY=
# Gemini 預設模型（可在系統設定頁改）
GEMINI_MODEL=gemini-2.5-flash
# 管理員帳號（逗號分隔，大小寫須完全一致）；可進入系統設定頁。留空表示沒有管理員
ADMIN_USERNAMES=

# ===== 應用程式 =====
# 登入有效天數
SESSION_DAYS=7
# 對話回覆鎖逾時秒數（串流中每 30 秒更新一次，應大於 30）
REPLY_LOCK_TTL_SECONDS=90

# ===== 知識庫 =====
# Milvus token（有啟用驗證時使用，否則留空）
MILVUS_TOKEN=
# 儲存知識庫片段的 collection 名稱
MILVUS_COLLECTION=phoebe_chunks
# 檢索回傳的片段數
KB_TOP_K=5
# 單檔上傳上限（MB）
MAX_UPLOAD_MB=50
# worker 輪詢間隔（秒）
KB_WORKER_POLL_SECONDS=2
# 解析中逾時多久視為卡住並重新排入（秒）
KB_STALE_SECONDS=120
# 處理中的文件每隔幾秒刷新 updated_at（須小於 KB_STALE_SECONDS）
KB_HEARTBEAT_SECONDS=30

# ===== Embedding 服務（embedder）=====
# 文字與圖片共用的 embedding 模型（sentence-transformers，CPU float32；首次啟動會下載約 1.5 GB）
EMBED_MODEL_ID=google/embeddinggemma-2
# 每張圖片的 soft token 數（預設 280）
EMBED_IMAGE_TOKENS=280

# ===== OCR =====
# OCR 模型（vllm 服務載入；GPU 專用於 OCR）
OCR_MODEL=lightonai/LightOnOCR-3-0.8B
# LiteParse 的 OCR 語言
LITEPARSE_OCR_LANGUAGE=chi_tra+eng
# vLLM 使用的 GPU 記憶體比例（GPU 專用於 OCR；RTX 2060 實測 0.8 可用，0.85 會因桌面佔用而失敗）
OCR_VLLM_GPU_UTIL=0.8
# vLLM 的最大上下文長度（LightOnOCR 0.8B 官方建議 18000）
OCR_VLLM_MAX_MODEL_LEN=18000
# vLLM 同時處理的序列數上限（預設 256 在 6GB 顯卡配不到 KV cache）
OCR_VLLM_MAX_NUM_SEQS=8

# ===== 由 docker-compose.yml 固定的設定（不要在此覆寫）=====
# DB_PATH、KB_DIR：固定為 /data 下的路徑（phoebe-data volume）
# MILVUS_URI：固定為 http://milvus:19530
# OLLAMA_BASE_URL：固定為 http://host.docker.internal:11434
# KB_WORKER_MODE：web 固定為 external
# OCR_BACKEND：worker 固定為 vllm
# VLLM_BASE_URL：worker 固定為 http://vllm:8000/v1
# FRONTEND_DIST：使用映像內建的前端
