# Phoebe Docker 部署設定：在 docker/ 目錄執行 cp .env.example .env 後修改。
# 此檔同時供 Compose 變數插值（${...}）與容器環境變數使用。
# 專案根目錄的 .env 只給本機快速測試，與此檔無關。

# ===== Compose 與連接埠 =====
# 對外連接埠
PHOEBE_PORT=8000
# Gunicorn worker 數量
WEB_CONCURRENCY=2

# ===== Ollama 與模型 =====
# 對話模型（Ollama 在主機上，位址由 compose 固定）
CHAT_MODEL=gemma4:e4b
# 評測用的評審模型
EVAL_JUDGE_MODEL=qwen3.5:4b
# 是否啟用思考模式（true/false）
CHAT_THINK=true
# Ollama 每次對話的 context 長度（token）。Ollama 自己的預設只有 4096，
# 知識庫回答帶整頁圖（每張約 740 token）與多頁文字時會被截斷
OLLAMA_NUM_CTX=16384

# ===== Gemini 與管理員 =====
# 預設的聊天供應商（gemini／ollama）；管理員在系統設定頁改過之後以設定頁為準
LLM_PROVIDER=gemini
# Gemini API key（到 https://aistudio.google.com/apikey 取得）。只放在這裡，不會存進資料庫，也不會出現在介面。
GEMINI_API_KEY=
# Gemini 預設模型（可在系統設定頁改）
GEMINI_MODEL=gemini-3.5-flash-lite
# 管理員帳號：服務啟動時自動建立；已存在時把密碼同步成這裡的值（改密碼＝改這裡再重啟，舊的登入會被登出）。
# 兩個都留空表示沒有管理員。帳號 3–32 字元、密碼 8 字元以上（最多 72 位元組）
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== 應用程式 =====
# 登入有效天數
SESSION_DAYS=7
# 對話回覆鎖逾時秒數（串流中每 30 秒更新一次，應大於 30）
REPLY_LOCK_TTL_SECONDS=90

# ===== 知識庫 =====
# Milvus token（有啟用驗證時使用，否則留空）
MILVUS_TOKEN=
# 儲存知識庫片段的 collection 名稱
MILVUS_COLLECTION=phoebe_chunks
# 檢索回傳的片段數
KB_TOP_K=5
# 混合查詢中向量那一路的預設權重（0–1），關鍵字（BM25）為 1 減去它；0.5 表示兩者相同。
# 知識庫可在「知識庫設定」自訂自己的權重，沒有自訂的才用這個值
# 分數算法同 Milvus WeightedRanker：向量 (1+cos)/2、關鍵字 2·atan(BM25)/π，再加權相加
KB_VECTOR_WEIGHT=0.5
# 回答時附給模型的參考圖片上限（依參考資料順序，頁面圖優先）；0 表示不附圖
KB_MAX_IMAGES=4
# 單檔上傳上限（MB）
MAX_UPLOAD_MB=50
# ingest 輪詢間隔（秒）
KB_INGEST_POLL_SECONDS=2
# ingest 同時處理幾份文件（正整數，預設 1）
INGEST_CONCURRENCY=1
# 解析中逾時多久視為卡住並重新排入（秒）
KB_STALE_SECONDS=120
# 處理中的文件每隔幾秒刷新 updated_at（須小於 KB_STALE_SECONDS）
KB_HEARTBEAT_SECONDS=30

# ===== Embedding 服務（embedder）=====
# 文字與圖片共用的 embedding 模型（sentence-transformers，CPU float32；首次啟動會下載約 1.5 GB）
EMBED_MODEL_ID=google/embeddinggemma-2
# 每張圖片的 soft token 數（預設 280）
EMBED_IMAGE_TOKENS=280

# ===== OCR =====
# OCR 模型（vllm 服務載入；GPU 專用於 OCR）
OCR_MODEL=lightonai/LightOnOCR-3-0.8B
# LiteParse 的 OCR 語言
LITEPARSE_OCR_LANGUAGE=chi_tra+eng
# vLLM 使用的 GPU 記憶體比例（GPU 專用於 OCR；RTX 2060 實測 0.8 可用，0.85 會因桌面佔用而失敗）
OCR_VLLM_GPU_UTIL=0.8
# vLLM 的最大上下文長度（LightOnOCR 0.8B 官方建議 18000）
OCR_VLLM_MAX_MODEL_LEN=18000
# vLLM 同時處理的序列數上限（預設 256 在 6GB 顯卡配不到 KV cache）
OCR_VLLM_MAX_NUM_SEQS=4
# LightOnOCR 每份文件同時送給 vLLM 的頁數（正整數）。
# vLLM 同時收到的請求數 = INGEST_CONCURRENCY × OCR_CONCURRENCY，這個乘積不要超過
# vLLM 的 --max-num-seqs（4），超過的部分會在 vLLM 內排隊、拖長每頁的時間
OCR_CONCURRENCY=4
# 每頁 OCR 請求的逾時（秒，正數）；在 vLLM 內排隊的時間也算在內
OCR_TIMEOUT_SECONDS=600

# ===== 由 docker-compose.yml 固定的設定（不要在此覆寫）=====
# DB_PATH、KB_DIR：固定為 /data 下的路徑（phoebe-data volume）
# MILVUS_URI：固定為 http://milvus:19530
# OLLAMA_BASE_URL：固定為 http://host.docker.internal:11434
# KB_INGEST_MODE：web 固定為 external
# OCR_BACKEND：ingest 固定為 vllm
# VLLM_BASE_URL：ingest 固定為 http://vllm:8000/v1
# FRONTEND_DIST：使用映像內建的前端
